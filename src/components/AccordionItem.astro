---
import type { MiniCase } from "@data/miniCases";

interface Props {
  item: MiniCase;
  index: number;
}

const { item } = Astro.props;
---

<div class="accordion-item">
  <button class="accordion-trigger group flex w-full cursor-pointer items-center justify-between border-none bg-transparent py-5 text-left font-sans text-ink">
    <div>
      <div class="mb-1 flex items-center gap-2">
        <span class="font-sans text-[10px] font-semibold uppercase tracking-[0.14em] text-[#8c3208]">{item.tag}</span>
        <span class="text-[10px] text-border">/</span>
        <span class="font-sans text-[10px] font-normal uppercase tracking-[0.12em] text-ink-muted">{item.companyYear}</span>
      </div>
      <div class="font-sans text-[17px] font-medium leading-[1.35] text-ink transition-colors duration-150 group-hover:text-ink-soft">
        {item.title}
      </div>
    </div>
    <span class="accordion-icon ml-4 shrink-0 text-[20px] font-light leading-none text-ink-muted transition-transform duration-[250ms] ease-in-out">+</span>
  </button>

  <div class="accordion-body grid [grid-template-rows:0fr] transition-[grid-template-rows] duration-300 ease-in-out">
    <div class="overflow-hidden">
      <div class="grid grid-cols-1 gap-6 pb-8 md:[grid-template-columns:1fr_260px] md:gap-12">

        <div class="space-y-4 text-[15px] leading-[1.8] text-ink-soft">
          {item.desc1 && <p>{item.desc1}</p>}
          {item.desc2 && <p>{item.desc2}</p>}
        </div>

        <div>
          {item.skills.length > 0 && (
            <>
              <div class="mb-2 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-muted">What I did</div>
              <div class="flex flex-wrap gap-1.5">
                {item.skills.map((s) => (
                  <span class="inline-block rounded-[20px] border border-border px-3 py-[3px] font-sans text-xs font-medium text-ink-soft [border-width:1.5px]">
                    {s}
                  </span>
                ))}
              </div>
            </>
          )}
          {item.industry && (
            <>
              <div class="mb-2 mt-5 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-muted">Industry</div>
              <div class="text-sm leading-[1.5] text-ink-soft">{item.industry}</div>
            </>
          )}
          {item.asideValue && (
            <>
              <div class="mb-2 mt-5 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-muted">{item.asideLabel ?? "Context"}</div>
              <div class="text-sm leading-[1.5] text-ink-soft">{item.asideValue}</div>
            </>
          )}
        </div>

      </div>
    </div>
  </div>
</div>
