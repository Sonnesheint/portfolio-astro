---
interface Props {
  heading?: string;
  body?: string;
  category?: string;
  year?: string;
}

const {
  heading = "Section Heading",
  body = "Supporting body text that provides context and detail about this section or project item.",
  category = "CATEGORY",
  year = "2024",
} = Astro.props;
---

<div class="w-full max-w-[440px] bg-bg px-7 py-8">
  <div class="flex items-center gap-2 mb-4">
    <div class="w-16 h-2 bg-accent flex-shrink-0"></div>
    <div class="flex-1 h-px bg-ink"></div>
  </div>

  <div class="flex items-start justify-between gap-4">
    <h2 class="font-serif text-[22px] font-bold leading-tight text-ink">{heading}</h2>
    <span
      class="flex-shrink-0 text-ink-muted text-[10.5px] uppercase tracking-[0.1em] mt-1"
      style="font-family:'JetBrains Mono',monospace"
    >
      {year}
    </span>
  </div>

  <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">{body}</p>

  <span
    class="inline-block mt-5 text-[10.5px] uppercase tracking-[0.1em] text-ink-muted"
    style="font-family:'JetBrains Mono',monospace"
  >
    {category}
  </span>
</div>

