---
interface Props {
  title: string;
  description: string;
  category: string;
  client: string;
  year: string | number;
  href?: string;
  featured?: boolean;
}

const { title, description, category, client, year, href = "#", featured = false } = Astro.props;
---

<div class={`card-wrapper${featured ? ' card-featured' : ''}`}>
  <div class="card-tab-row">
    <div class="card-tab">{category}</div>
    {featured && <div class="card-featured-badge">Pinned</div>}
  </div>
  <a class="card-body" href={href}>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <div class="card-meta">
      <span class="card-client">{client} · {year}</span>
      <span class="card-arrow">→</span>
    </div>
  </a>
</div>

<style>
  .card-wrapper {
    width: 100%;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .card-wrapper:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 0 var(--color-accent, #c44e10);
  }
  .card-tab-row {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .card-featured .card-body {
    border-color: var(--color-accent, #c44e10);
    border-width: 2px;
  }
  .card-featured-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent, #c44e10);
    border: 1.5px solid var(--color-accent, #c44e10);
    padding: 0.3rem 0.65rem;
    margin-bottom: 0;
  }
  .card-tab {
    display: inline-block;
    background: var(--color-ink, #1a0e04);
    color: var(--color-cream, #faf6f1);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.45rem 1rem 0.45rem 0.75rem;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 100%, 0 100%);
    padding-right: 1.5rem;
  }
  .card-body {
    display: block;
    border: 1.5px solid var(--color-ink, #1a0e04);
    background: var(--color-bg-alt, #f5f0e8);
    padding: 2rem;
    border-radius: 0;
    text-decoration: none;
    color: inherit;
  }
  .card-title {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-ink, #1a0e04);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }
  .card-desc {
    font-size: 1rem;
    color: var(--color-body, #3a2a1a);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-client {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted, #b5552a);
  }
  .card-arrow {
    color: var(--color-accent, #c44e10);
    font-size: 1rem;
  }
</style>
