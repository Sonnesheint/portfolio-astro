---
interface Props {
  title: string;
  description: string;
  category: string;
  client: string;
  year: string | number;
  href?: string;
  featured?: boolean;
  image?: string;
  imagePosition?: string;
}

const { title, description, category, client, year, href = "#", featured = false, image, imagePosition = "center" } = Astro.props;
---

<div class={`card-wrapper${featured ? ' card-featured' : ''}`}>
  <div class="card-tab-row">
    <div class="card-tab">{category}</div>
    {featured && <div class="card-featured-badge">Pinned</div>}
  </div>
  <a class="card-body" href={href}>
    <div class={`card-thumb${featured ? ' card-thumb-featured' : ''}`}>
      {image
        ? <img src={image} alt={title} class="card-thumb-img" style={`object-position: ${imagePosition}`} />
        : <span class="card-thumb-icon">◈</span>
      }
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <div class="card-meta">
      <span class="card-client">{client} · {year}</span>
      <span class="card-arrow">→</span>
    </div>
  </a>
</div>

<style>
  .card-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.12s ease;
  }
  .card-wrapper:hover {
    transform: translate(-2px, -2px);
  }
  .card-wrapper:hover .card-body {
    box-shadow: 4px 4px 0 0 var(--color-accent, #be4e10);
  }
  .card-tab-row {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .card-tab {
    display: inline-block;
    background: var(--color-ink, #1a0e04);
    color: var(--color-cream, #faf6f1);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.45rem 1rem 0.45rem 0.75rem;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 100%, 0 100%);
    padding-right: 1.5rem;
  }
  .card-featured-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent, #be4e10);
    border: 1.5px solid var(--color-accent, #be4e10);
    padding: 0.3rem 0.65rem;
    margin-bottom: 0;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    border: 1.5px solid var(--color-ink, #1a0e04);
    background: var(--color-bg-alt, #f5f0e8);
    padding: 0;
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: box-shadow 0.12s ease;
  }
  .card-featured .card-body {
    border-color: var(--color-accent, #be4e10);
    border-width: 2px;
  }
  .card-thumb {
    width: 100%;
    aspect-ratio: 16 / 7;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5ede0 0%, #e8d5bc 50%, #dfc5a4 100%);
    position: relative;
  }
  .card-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 20px,
      rgba(196, 78, 16, 0.04) 20px,
      rgba(196, 78, 16, 0.04) 21px
    );
  }
  .card-thumb-featured {
    background: linear-gradient(135deg, #f0e0cc 0%, #e0c4a0 50%, #c9a07a 100%);
  }
  .card-thumb-icon {
    font-size: 2rem;
    color: rgba(196, 78, 16, 0.35);
    position: relative;
    z-index: 1;
  }
  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-title {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-ink, #1a0e04);
    line-height: 1.25;
    margin: 1.25rem 2rem 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-desc {
    font-size: 1rem;
    color: var(--color-body, #3a2a1a);
    line-height: 1.6;
    margin: 0 2rem 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem 1.5rem;
    margin-top: auto;
  }
  .card-client {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted, #ac552a);
  }
  .card-arrow {
    color: var(--color-accent, #be4e10);
    font-size: 1rem;
  }
</style>
