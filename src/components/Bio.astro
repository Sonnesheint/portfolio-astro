---
import { BIO } from "@data/bio";
---

<section id="bio" class="[border-bottom:1px_solid_rgba(201,168,130,0.3)] bg-bg-alt">
  <div class="section-inner">
    <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-[1fr_280px] md:gap-16">

      <!-- Lewa kolumna: prose -->
      <div>
        <p class="bio-claim">{BIO.claim}</p>
        <p class="bio-prose">
          {BIO.prose.map((sentence, i) => (
            <>
              {sentence === "Then you know."
                ? <span class="bio-pivot">{sentence}</span>
                : <span>{sentence}</span>
              }
              {i < BIO.prose.length - 1 && <span class="bio-sep"> / </span>}
            </>
          ))}
        </p>
      </div>

      <!-- Prawa kolumna: annotacja (ukryta na mobile) -->
      <div class="hidden md:block border-l border-dashed border-[var(--color-separator)] pl-8 pt-1">
        <p class="bio-annotation-label">← THE PIVOT</p>
        <p class="bio-annotation-text">The sentence where the reader realises the thing was working all along.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .bio-claim {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }
  .bio-prose {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }
  .bio-sep {
    color: var(--color-accent);
  }
  .bio-pivot {
    border-bottom: 2px solid var(--color-accent);
  }
  .bio-annotation-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .bio-annotation-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-body);
  }
</style>
