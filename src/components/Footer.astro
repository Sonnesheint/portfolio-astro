---
import { SITE } from "@data/site";

const currentYear = new Date().getFullYear();
---

<footer class="bg-bg-alt">
  <div class="mx-auto max-w-[1100px] px-12 pb-8">
    <hr style="border: none; border-top: 0.5px solid #C5B9AB; margin: 0;" />
    <p class="py-6 text-xs text-ink-muted">© {currentYear} {SITE.author}</p>
  </div>
</footer>
