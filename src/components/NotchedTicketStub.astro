---
interface Props {
  title?: string;
  label?: string;
  description?: string;
  href?: string;
}

const {
  title = "LinkedIn",
  label = "CONNECT",
  description = "Senior UX Writer & Content Designer",
  href = "https://linkedin.com",
} = Astro.props;
---

<a class="notched-ticket group block w-full max-w-[440px] text-ink no-underline" href={href} target="_blank" rel="noopener noreferrer">
  <div class="notched-inner p-6">
    <span
      class="block text-[10.5px] uppercase tracking-[0.1em] opacity-60 mb-2"
      style="font-family:'JetBrains Mono',monospace"
    >
      {label}
    </span>

    <p class="text-[14px] leading-relaxed mb-4 opacity-80">{description}</p>

    <div class="flex items-center justify-between">
      <span class="font-serif text-[20px] font-bold">{title}</span>
      <span class="text-[20px] transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
    </div>
  </div>
</a>

<style>
  .notched-ticket {
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink, #1a0e04);
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .notched-ticket:hover {
    background: var(--color-ink, #1a0e04);
    color: var(--color-bg);
  }
</style>
