---
import { SITE } from "@data/site";
import StampedButton from "@components/StampedButton.astro";
import NotchedButton from "@components/NotchedButton.astro";
---

<section id="hero" class="relative overflow-hidden [border-bottom:1px_solid_rgba(201,168,130,0.3)]">

  <div class="absolute inset-0 z-0 bg-cover bg-center" style="background-image: url('/images/bass-guitar.jpg')"></div>
  <div class="absolute inset-0 z-[1] bg-[rgba(253,246,236,0.92)]"></div>

  <div class="relative z-[15] mx-auto grid max-w-[1100px] grid-cols-1 items-center gap-10 px-6 pt-5 pb-6 md:grid-cols-2 md:gap-20 md:px-12 md:pt-[100px] md:pb-[88px]">

    <div>
      <p class="mb-7 hidden font-sans text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted md:block">
        <span>UX WRITER</span> ·
        <span>CONTENT DESIGNER</span>
      </p>
      <h1 class="font-serif text-center text-[36px] font-bold leading-none tracking-[-0.02em] text-ink md:text-left md:text-[56px]">
        Good UX writing<br />
        is like <em class="mt-2 inline-block bg-accent px-2 pb-[6px] text-white">bass guitar</em>
      </h1>
      <div class="my-5"></div>
      <p class="hero-prose">
        <span>Most people don't notice it.</span><span class="sep"> / </span><span>Unless something goes wrong.</span><span class="sep"> / </span><span class="pivot">Then you know.</span><span class="sep"> / </span><span>It was holding everything together.</span>
      </p>
      <div class="hero-sig">
        <p class="hero-name">I'm Piotr.</p>
        <p class="hero-tagline">I make sure nothing goes wrong.</p>
      </div>
      <div class="mt-8 mb-3 flex flex-col items-center gap-4 md:mb-0 md:flex-row">
        <StampedButton label="View projects" href="#work" />
        <NotchedButton label="Get in touch" href="#contact" />
      </div>
    </div>

    <div class="order-first flex justify-center md:order-none">
      <div class="relative mb-3 mr-3 h-[240px] w-[200px] shrink-0 md:h-[380px] md:w-[320px]">
        <div class="absolute -bottom-2 -right-2 z-0 h-full w-full rounded-[4px] border-2 border-accent md:-bottom-3 md:-right-3"></div>
        <div class="relative z-[1] h-full w-full overflow-hidden rounded-[4px]">
          <img
            class="h-full w-full object-cover object-top"
            src="/images/piotr.jpg"
            width="320"
            height="380"
            alt={`${SITE.author} — Senior UX Writer`}
          />
        </div>
      </div>
    </div>

  </div>

  <div
    class="pointer-events-none absolute bottom-0 left-0 z-[5] h-20 w-full backdrop-blur-[4px]"
    style="background: linear-gradient(to bottom, rgba(253,246,236,0) 0%, rgba(253,246,236,0.4) 30%, rgba(253,246,236,1) 100%);"
  ></div>

</section>

<style>
  .hero-prose {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink, #1a0e04);
    margin-bottom: 1.5rem;
  }
  .sep {
    color: var(--color-accent, #c44e10);
  }
  .pivot {
    border-bottom: 2px solid var(--color-accent, #c44e10);
  }
  .hero-sig {
    margin-bottom: 0.5rem;
  }
  .hero-name {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--color-ink, #1a0e04);
    line-height: 1.2;
  }
  .hero-tagline {
    font-family: var(--sans);
    font-size: 1.1rem;
    color: var(--color-body, #3a2a1a);
    margin-top: 0.3rem;
  }
</style>
