---
import { SITE } from "@data/site";
import StampedButton from "@components/StampedButton.astro";
import NotchedButton from "@components/NotchedButton.astro";
---

<section id="hero" class="relative overflow-hidden [border-bottom:1px_solid_rgba(201,168,130,0.3)]">

  <div class="absolute inset-0 z-0 bg-cover bg-center" style="background-image: url('/images/bass-guitar.jpg')"></div>
  <div class="absolute inset-0 z-[1] bg-[rgba(253,246,236,0.92)]"></div>

  <div class="relative z-[15] mx-auto grid max-w-[1100px] grid-cols-1 items-center gap-10 px-6 pt-5 pb-6 md:grid-cols-2 md:gap-20 md:px-12 md:pt-[100px] md:pb-[88px]">

    <div>
      <p class="mb-7 hidden font-sans text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted md:block">
        <span>SENIOR UX WRITER</span> ·
        <span>CONTENT DESIGNER</span>
      </p>

      <h1 class="font-serif text-center text-[36px] font-bold leading-none tracking-[-0.02em] text-ink md:text-left md:text-[56px]">
        I'm Piotr.
      </h1>

      <p class="hero-aside">
        Probably the best UX Writer<br class="md:hidden" /> among bassists.
      </p>

      <h2 class="font-serif text-center text-[36px] font-bold leading-none tracking-[-0.02em] text-ink md:text-left md:text-[56px] mt-2">
        I <em class="inline-block bg-accent px-2 pb-[6px] text-white not-italic">tune</em> the voice<br />
        of your product.
      </h2>

      <div class="my-5"></div>

      <p class="hero-usp">
        <strong>In-house for 10 years. Agency for 3.</strong><br />
      </p>

      <div class="mt-8 mb-3 flex flex-col items-center gap-4 md:mb-0 md:flex-row">
        <StampedButton label="View projects" href="#work" />
        <NotchedButton label="Get in touch" href="#contact" />
      </div>
    </div>

    <div class="order-first flex justify-center md:order-none">
      <div class="flex flex-col items-center">
      <div class="relative mb-3 mr-3 h-[240px] w-[200px] shrink-0 md:h-[380px] md:w-[320px]">
        <div class="absolute -bottom-2 -right-2 z-0 h-full w-full rounded-[4px] border-2 border-accent md:-bottom-3 md:-right-3"></div>
        <div class="relative z-[1] h-full w-full overflow-hidden rounded-[4px]">
          <img
            class="h-full w-full object-cover object-top"
            src="/images/piotr.jpg"
            width="320"
            height="380"
            alt={`${SITE.author} — Senior UX Writer · Content Designer`}
          />
        </div>

        <!-- Kredkowy dymek -->
        <div class="hero-bubble-wrap">
          <svg
            class="hero-bubble-svg"
            viewBox="0 0 260 150"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <defs>
              <filter id="bubbleRough" x="-8%" y="-14%" width="116%" height="128%">
                <feTurbulence
                  type="fractalNoise"
                  baseFrequency="0.02"
                  numOctaves="4"
                  seed="7"
                  result="noise"
                />
                <feDisplacementMap
                  in="SourceGraphic"
                  in2="noise"
                  scale="6"
                  xChannelSelector="R"
                  yChannelSelector="G"
                />
              </filter>
            </defs>
            <path
              d="
                M 22 38
                Q 90 32 118 35
                L 130 6
                L 148 35
                Q 200 30 244 38
                Q 254 40 254 52
                Q 257 84 252 116
                Q 251 128 238 130
                Q 195 134 155 130
                Q 110 127 70 130
                Q 20 129 8 116
                Q 4 84  6 52
                Q 6 39 22 38
                Z
              "
              fill="#fffdf9"
              stroke="#1a0e04"
              stroke-width="5"
              stroke-linejoin="round"
              stroke-linecap="round"
              filter="url(#bubbleRough)"
            />
          </svg>
          <p class="hero-bubble-text">
            Hello there
          </p>
        </div>

      </div>
      <div class="hero-availability">
        <span class="hero-availability-dot"></span>
        Available for new projects
      </div>
      </div>
    </div>

  </div>

  <div
    class="pointer-events-none absolute bottom-0 left-0 z-[5] h-20 w-full backdrop-blur-[4px]"
    style="background: linear-gradient(to bottom, rgba(253,246,236,0) 0%, rgba(253,246,236,0.4) 30%, rgba(253,246,236,1) 100%);"
  ></div>

</section>

<style>
  .hero-aside {
    font-family: var(--sans);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-body, #3a2a1a);
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-aside {
      text-align: left;
    }
  }

  .hero-usp {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink, #1a0e04);
    text-align: center;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-usp {
      text-align: left;
      border-left: 2px solid var(--color-accent, #be4e10);
      padding-left: 0.85rem;
    }
  }
  .hero-usp strong {
    color: var(--color-accent, #be4e10);
  }

  .hero-prose {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink, #1a0e04);
    margin-bottom: 1.5rem;
  }
  .sep {
    color: var(--color-accent, #be4e10);
  }
  .pivot {
    border-bottom: 2px solid var(--color-accent, #be4e10);
  }

  .hero-availability {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--color-body, #3a2a1a);
    margin-top: 0.6rem;
  }

  .hero-availability-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #639922;
    flex-shrink: 0;
  }

  .hero-bubble-wrap {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 10;
    width: 260px;
    transform: translate(-50%, -40%) rotate(-2deg);
    display: none;
  }

  .hero-bubble-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-bubble-text {
    position: absolute;
    top: 62%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink, #1a0e04);
    text-align: left;
    pointer-events: none;
  }
</style>
