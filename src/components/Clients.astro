---
import { CLIENTS } from "@data/clients";
import SectionHeading from "@components/SectionHeading.astro";
---

<section id="clients" class="border-b border-b-border/30 bg-bg">
  <div class="section-inner">
    <SectionHeading title="Companies I've worked with" />
    <p class="clients-flow">
      {CLIENTS.map((name, i) => (
        <><span class="clients-name">{name}</span>{i < CLIENTS.length - 1 ? <span class="clients-sep"> · </span> : "."}</>
      ))}
    </p>
    <p class="clients-cta">Want to be next?</p>
  </div>
</section>

<style>
  .clients-flow {
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-ink, #1a0e04);
  }
  .clients-sep {
    color: var(--color-accent, #c44e10);
    font-weight: 400;
  }
  .clients-cta {
    margin-top: 1.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent, #c44e10);
  }
</style>
