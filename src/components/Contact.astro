---
import { SITE } from "@data/site";
---

<section id="contact">
  <div class="contact-inner">
    <h2 class="contact-title">Let's work together</h2>
    <p class="contact-sub">I will make sure your product has a soul and always hits the right note</p>
    <div class="contact-btns">
      <a href={`mailto:${SITE.email}`} class="btn-email">Write me→</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener" class="btn-linkedin">LinkedIn ↗</a>
    </div>
  </div>
</section>
