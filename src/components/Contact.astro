---
import { SITE } from "@data/site";
---

<section id="contact" class="bg-bg-alt">
  <div class="mx-auto max-w-[1100px] px-6 py-16 text-center md:px-12 md:py-24">
    <h2 class="mb-5 font-serif text-[36px] leading-[1.05] tracking-[-0.02em] text-ink md:text-[52px]">
      Let's work together
    </h2>
    <p class="mb-12 text-[15px] leading-[1.7] text-ink/70 md:text-[17px]">
      I will make sure your product has a soul and always hits the right note
    </p>
    <div class="flex flex-col items-center gap-4 md:flex-row md:justify-center">
      <a
        href={`mailto:${SITE.email}`}
        class="w-full max-w-[320px] rounded-lg bg-accent px-7 py-3.5 text-center text-[15px] font-semibold text-white transition-opacity duration-150 hover:opacity-90 md:w-auto md:max-w-none"
      >
        Write me→
      </a>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener"
        class="w-full max-w-[320px] rounded-lg border border-ink-muted px-7 py-3.5 text-center text-[15px] font-semibold text-ink transition-all duration-150 hover:border-ink md:w-auto md:max-w-none"
      >
        LinkedIn ↗
      </a>
    </div>
  </div>
</section>
