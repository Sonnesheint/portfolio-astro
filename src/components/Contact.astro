---
import { SITE } from "@data/site";
import StampedButton from "@components/StampedButton.astro";
import NotchedButton from "@components/NotchedButton.astro";
---

<section id="contact" class="bg-bg-alt">
  <div class="mx-auto max-w-[1100px] px-6 py-16 text-center md:px-12 md:py-24">
    <h2 class="mb-5 font-serif font-bold text-[36px] leading-[1.05] tracking-[-0.02em] text-ink md:text-[52px]">
      Let's work together
    </h2>
    <p class="mb-12 text-[15px] leading-[1.7] text-ink/70 md:text-[17px]">
      I will make sure your product has a soul and always hits the right note.
    </p>
    <div class="flex flex-col items-center gap-4 md:flex-row md:justify-center">
      <StampedButton label="Write me" href={`mailto:${SITE.email}`} />
      <NotchedButton label="LinkedIn" href={SITE.linkedin} target="_blank" />
    </div>
  </div>
</section>
