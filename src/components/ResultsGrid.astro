---
interface Result {
  number: string;
  desc: string;
}

interface Props {
  items: [Result, Result, Result];
}

const { items } = Astro.props;
---

<div class="my-6 grid grid-cols-3 gap-px border border-border-light bg-border-light">
  {items.map((item) => (
    <div class="bg-bg p-6">
      <div class="font-sans text-4xl font-semibold leading-none text-accent">{item.number}</div>
      <div class="mt-2 text-[13px] leading-[1.5] text-ink-soft">{item.desc}</div>
    </div>
  ))}
</div>
