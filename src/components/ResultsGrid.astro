---
interface Result {
  number: string;
  desc: string;
}

interface Props {
  items: [Result, Result, Result];
  horizontal?: boolean;
}

const { items, horizontal = false } = Astro.props;

function parseCountable(str: string): { value: number | null; suffix: string } {
  const m = str.match(/^(\d+(?:\.\d+)?)(.*)/);
  return m ? { value: parseFloat(m[1]), suffix: m[2] } : { value: null, suffix: '' };
}
---

<div class={`results-wrap${horizontal ? ' results-wrap--h' : ''}`}>
{horizontal && <span class="results-label">Results</span>}
<div class={`results-list${horizontal ? ' results-list--h' : ''}`}>
  {items.map((item, i) => {
    const { value, suffix } = parseCountable(item.number);
    return (
      <div class="result-row">
        {!horizontal && <span class="result-num">{String(i + 1).padStart(2, "0")}</span>}
        <div class="result-body">
          <div
            class="result-value"
            data-count={value !== null ? String(value) : undefined}
            data-suffix={value !== null ? suffix : undefined}
          >{item.number}</div>
          <div class="result-desc">{item.desc}</div>
        </div>
      </div>
    );
  })}
</div>
</div>

<style>
  .results-wrap { display: contents; }
  .results-wrap--h { display: block; margin-top: 1.75rem; }

  .results-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted, #b5552a);
    margin-bottom: 0.75rem;
  }

  .results-list { display: flex; flex-direction: column; margin: 1.5rem 0; }

  .results-list--h {
    flex-direction: row;
    gap: 0;
    margin: 0;
  }
  .results-list--h .result-row {
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 2rem 1.25rem 0;
  }
  .results-list--h .result-num {
    font-size: 0.7rem;
  }

  .result-row {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.25rem 0;
  }

  .result-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--color-accent);
    min-width: 2rem;
    padding-top: 0.2rem;
    padding-bottom: 0.15rem;
    border-bottom: 2px solid var(--color-accent);
    align-self: flex-start;
    flex-shrink: 0;
  }

  .result-value {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.2;
    margin-bottom: 0.3rem;
  }

  .result-desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-body);
  }
</style>

<script>
  function initCounters() {
    const els = document.querySelectorAll<HTMLElement>('.result-value[data-count]');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.animated) return;
        el.dataset.animated = 'true';
        observer.unobserve(el);

        const target = parseFloat(el.dataset.count!);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1400;
        const start = performance.now();

        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });

    els.forEach(el => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounters);
  } else {
    initCounters();
  }
</script>
