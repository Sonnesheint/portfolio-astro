---
interface Props {
  label?: string;
  href?: string;
  target?: string;
}

const {
  label = "Write me",
  href = "#",
  target,
} = Astro.props;
---

<a class="stamped-btn inline-flex items-center gap-3 px-6 py-3.5 no-underline" href={href} target={target}>
  <span class="font-serif text-[1.25rem] font-bold text-white leading-none">{label}</span>
  <span class="text-[1.25rem] text-white leading-none">→</span>
</a>

<style>
  .stamped-btn {
    background: #b5552a;
    border: 1.5px solid #1a0e04;
    border-radius: 0;
    box-shadow: 6px 6px 0 0 #1a0e04;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .stamped-btn:hover {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 0 #1a0e04;
  }
</style>
