---
import Layout from "@layouts/Layout.astro";

const tools = [
  { name: "JavaScript",         src: "/images/tools/javascript.svg" },
  { name: "Figma",              src: "/images/tools/figma.svg" },
  { name: "Cloudflare Workers", src: "/images/tools/cloudflare.svg" },
  { name: "Claude API",         src: "/images/tools/anthropic.svg" },
  { name: "Make.com",           src: "/images/tools/make.svg" },
  { name: "Notion",             src: "/images/tools/notion.svg" },
  { name: "Python",             src: "/images/tools/python.svg" },
  { name: "Confluence",         src: "/images/tools/confluence.svg" },
];

const sizes = [
  { id: "current", label: "Obecne — 16px", size: 16, fontSize: "12px", gap: "6px" },
  { id: "s20",     label: "A — 20px",      size: 20, fontSize: "13px", gap: "7px" },
  { id: "s26",     label: "B — 26px",      size: 26, fontSize: "14px", gap: "8px" },
  { id: "s32",     label: "C — 32px",      size: 32, fontSize: "15px", gap: "10px" },
];
---

<Layout title="Tools — rozmiary">
  <div class="wrap">
    {sizes.map(({ id, label, size, fontSize, gap }) => (
      <section class="variant" id={id}>
        <p class="variant-label">{label}</p>
        <div class="tools-row" style={`gap: 10px 28px;`}>
          {tools.map((t) => (
            <span class="tool-tag" style={`gap:${gap}; font-size:${fontSize};`}>
              <span
                class="mask-icon"
                role="img"
                aria-label={t.name}
                style={`width:${size}px;height:${size}px;background-color:#1a0e04;-webkit-mask-image:url(${t.src});mask-image:url(${t.src});-webkit-mask-size:contain;mask-size:contain;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;`}
              ></span>
              <span>{t.name}</span>
            </span>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .wrap {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 3rem 4rem;
  }
  .variant {
    padding: 2rem 0;
    border-top: 1px solid var(--color-separator);
  }
  .variant-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }
  .tools-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .tool-tag {
    display: inline-flex;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .mask-icon {
    display: block;
    flex-shrink: 0;
  }
</style>
