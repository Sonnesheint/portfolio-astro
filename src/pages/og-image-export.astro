---
// Export page — screenshot at exactly 1200×630 in browser devtools
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-pencil.svg" />
    <title>og:image export</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
        font-family: 'Outfit', 'Helvetica Neue', sans-serif;
      }
      .og {
        display: flex;
        width: 1200px;
        height: 630px;
      }
      .left {
        background: #c44e10;
        width: 460px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 64px;
      }
      .left .name {
        font-size: 64px;
        font-weight: 700;
        color: #faf6f1;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 20px;
      }
      .left .role {
        font-size: 20px;
        color: rgba(250, 246, 241, 0.75);
        font-weight: 500;
        line-height: 1.6;
      }
      .right {
        background: #faf6f1;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 64px;
      }
      .right ul {
        list-style: none;
        margin-bottom: 40px;
      }
      .right ul li {
        font-size: 22px;
        color: #3a2a1a;
        font-weight: 500;
        line-height: 1.9;
        padding-left: 20px;
        position: relative;
      }
      .right ul li::before {
        content: '·';
        position: absolute;
        left: 0;
        color: #c44e10;
        font-weight: 700;
      }
      .right .url {
        font-size: 17px;
        color: #c9a07a;
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body>
    <div class="og">
      <div class="left">
        <div class="name">Piotr Dudziński</div>
        <div class="role">
          Senior UX Designer<br />
          Content Designer | UX Writer
        </div>
      </div>
      <div class="right">
        <ul>
          <li>Digital banking (10 years)</li>
          <li>Plain language</li>
          <li>Content systems</li>
          <li>AI automation</li>
        </ul>
        <div class="url">piotrdudzinski.com</div>
      </div>
    </div>
  </body>
</html>
