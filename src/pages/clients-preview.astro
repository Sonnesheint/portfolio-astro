---
import Layout from "@layouts/Layout.astro";
import { CLIENTS } from "@data/clients";
---

<Layout title="Clients — warianty">
  <div class="preview-wrap">
    <header class="preview-header">
      <p class="label">PREVIEW — Sekcja firm</p>
      <h1>Companies I've worked with</h1>
    </header>

    <!-- WARIANT A: duże tagi / pills -->
    <section class="variant">
      <p class="variant-label">A — Pill tags</p>
      <div class="pills-grid">
        {CLIENTS.map((name) => <span class="pill">{name}</span>)}
      </div>
      <p class="cta">Want to be next?</p>
    </section>

    <div class="divider"></div>

    <!-- WARIANT B: duży serif flow -->
    <section class="variant">
      <p class="variant-label">B — Big serif flow</p>
      <p class="big-flow">
        {CLIENTS.map((name, i) => (
          <><span class="flow-name">{name}</span>{i < CLIENTS.length - 1 ? <span class="flow-sep"> · </span> : "."}</>
        ))}
      </p>
      <p class="cta">Want to be next?</p>
    </section>

    <div class="divider"></div>

    <!-- WARIANT A+B: duże serif pills -->
    <section class="variant">
      <p class="variant-label">A+B — Serif pills</p>
      <div class="serif-pills">
        {CLIENTS.map((name) => <span class="serif-pill">{name}</span>)}
      </div>
      <p class="cta">Want to be next?</p>
    </section>

    <div class="divider"></div>

    <!-- WARIANT C: grid z numerami -->
    <section class="variant">
      <p class="variant-label">C — Numbered grid</p>
      <div class="num-grid">
        {CLIENTS.map((name, i) => (
          <div class="num-row">
            <span class="num-index">{String(i + 1).padStart(2, "0")}</span>
            <span class="num-name">{name}</span>
          </div>
        ))}
      </div>
      <p class="cta">Want to be next?</p>
    </section>

  </div>
</Layout>

<style>
  .preview-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }
  .preview-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-separator);
    padding-bottom: 1.5rem;
  }
  .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .preview-header h1 {
    font-family: var(--serif, Georgia, serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .variant { padding: 2.5rem 0; }
  .variant-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }
  .divider {
    border-top: 1px solid var(--color-separator);
  }
  .cta {
    margin-top: 1.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  /* A — Pills */
  .pills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    padding: 0.5rem 1.1rem;
    white-space: nowrap;
    transition: background 0.12s, color 0.12s;
  }
  .pill:hover {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  /* A+B — Serif pills */
  .serif-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
  }
  .serif-pill {
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    padding: 0.4rem 1rem;
    white-space: nowrap;
    line-height: 1.3;
    transition: background 0.12s, color 0.12s;
  }
  .serif-pill:hover {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  /* B — Big serif flow */
  .big-flow {
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .flow-sep {
    color: var(--color-accent);
    font-weight: 400;
  }

  /* C — Numbered grid */
  .num-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1.5px solid var(--color-ink);
    border-left: 1.5px solid var(--color-ink);
  }
  .num-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-right: 1.5px solid var(--color-ink);
    border-bottom: 1.5px solid var(--color-ink);
  }
  .num-index {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }
  .num-name {
    font-family: var(--serif, Georgia, serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.2;
  }

  @media (max-width: 700px) {
    .num-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
