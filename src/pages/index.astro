---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Hero from "@components/Hero.astro";
import ProjectCard from "@components/ProjectCard.astro";
import AccordionRow from "@components/AccordionRow.astro";
import Clients from "@components/Clients.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import { PROJECTS } from "@data/projects";
import { MINI_CASES } from "@data/miniCases";
import SectionHeading from "@components/SectionHeading.astro";
---

<Layout>
  <Nav />

  <Hero />

  <!-- === SELECTED WORK === -->
  <section id="work">
    <div class="section-inner">
      <SectionHeading title="Featured projects" subtitle="FULL STORIES" id="projects" />

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {[...PROJECTS].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0)).map((project) => {
          const [client, year] = project.meta.split(' · ');
          return (
            <ProjectCard
              title={project.title}
              description={project.description}
              category={project.category}
              client={client}
              year={year}
              href={project.href}
              featured={project.featured}
              image={project.image}
              imagePosition={project.imagePosition}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- === MORE WORK (ACCORDIONS) === -->
  <section id="more-work">
    <div class="section-inner">
      <SectionHeading title="Bytes from everyday work" subtitle="MINI-CASE STUDIES" />

      <div>
        {MINI_CASES.map((item) => (
          <AccordionRow title={item.title} meta={`${item.tag} · ${item.companyYear}`}>
            <div class="grid grid-cols-1 gap-6 pb-6 md:grid-cols-[1fr_260px] md:gap-12">
              <div class="space-y-4 text-[15px] leading-[1.8] text-ink-soft">
                {item.desc1 && <p>{item.desc1}</p>}
                {item.desc2 && <p>{item.desc2}</p>}
                {item.desc3 && <p>{item.desc3}</p>}
                {item.caseLink && (
                  <p class="text-[13px]">
                    Wanna read the full story?{" "}
                    <a href={item.caseLink} class="font-medium text-accent hover:underline">Dive in →</a>
                  </p>
                )}
              </div>
              <div>
                {item.skills.length > 0 && (
                  <>
                    <div class="mb-2 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-muted">What I did</div>
                    <div class="flex flex-wrap gap-1.5">
                      {item.skills.map((s) => (
                        <span class="inline-block border border-border px-3 py-[3px] font-sans text-xs font-medium text-ink-soft [border-width:1.5px]">{s}</span>
                      ))}
                    </div>
                  </>
                )}
                {item.industry && (
                  <>
                    <div class="mb-2 mt-5 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-muted">Industry</div>
                    <div class="text-sm leading-[1.5] text-ink-soft">{item.industry}</div>
                  </>
                )}
                {item.asideValue && (
                  <>
                    <div class="mb-2 mt-5 text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-muted">{item.asideLabel ?? "Context"}</div>
                    <div class="text-sm leading-[1.5] text-ink-soft">{item.asideValue}</div>
                  </>
                )}
              </div>
            </div>
          </AccordionRow>
        ))}
      </div>
    </div>
  </section>

  <Clients />

  <Contact />

  <Footer />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".accordion-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".accordion-item");
      const isOpen = item?.classList.contains("open");
      document.querySelectorAll(".accordion-item.open").forEach((el) => {
        el.classList.remove("open");
      });
      if (!isOpen) item?.classList.add("open");
    });
  });

</script>
